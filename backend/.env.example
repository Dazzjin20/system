# Copy this file to .env and fill with your values (do NOT commit real secrets)

# Server
PORT=3000
NODE_ENV=development

# MongoDB (replace <user>, <password>, <dbname>)
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/<dbname>

# Authentication
JWT_SECRET=your_jwt_secret

# Frontend URL (used to restrict CORS in production)
FRONTEND_URL=http://localhost:3000

# Email (optional)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=

# Cloudinary or other upload provider (optional)
CLOUDINARY_URL=
